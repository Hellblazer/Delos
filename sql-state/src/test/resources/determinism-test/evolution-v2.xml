<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Evolution V2: Add columns and indexes -->
    <changeSet id="evolution-v2-1" author="test">
        <addColumn schemaName="PUBLIC" tableName="PRODUCTS">
            <column name="DESCRIPTION" type="VARCHAR(500)"/>
            <column name="CATEGORY" type="VARCHAR(50)"/>
        </addColumn>
    </changeSet>

    <changeSet id="evolution-v2-2" author="test">
        <createIndex schemaName="PUBLIC" tableName="PRODUCTS" indexName="IDX_PRODUCTS_CATEGORY">
            <column name="CATEGORY"/>
        </createIndex>
    </changeSet>

    <changeSet id="evolution-v2-3" author="test">
        <addColumn schemaName="PUBLIC" tableName="ORDERS">
            <column name="STATUS" type="VARCHAR(20)"/>
            <column name="TOTAL_AMOUNT" type="DECIMAL(10,2)"/>
        </addColumn>
    </changeSet>

    <changeSet id="evolution-v2-4" author="test">
        <createIndex schemaName="PUBLIC" tableName="ORDERS" indexName="IDX_ORDERS_PRODUCT_ID">
            <column name="PRODUCT_ID"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
