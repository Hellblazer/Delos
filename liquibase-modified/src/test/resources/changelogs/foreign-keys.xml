<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Foreign key constraint test for determinism validation.

        DETERMINISM REQUIREMENTS:
        - Explicit constraint names (no auto-generation)
        - Explicit ON DELETE/ON UPDATE rules
        - Consistent referential integrity enforcement
        - Sequential changeset IDs
     -->

    <changeSet id="1" author="test">
        <comment>Create parent table (customers)</comment>
        <createTable tableName="customers">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="test">
        <comment>Create child table (orders)</comment>
        <createTable tableName="orders">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="order_date" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="3" author="test">
        <comment>Add foreign key constraint from orders to customers</comment>
        <addForeignKeyConstraint
            constraintName="fk_orders_customer"
            baseTableName="orders"
            baseColumnNames="customer_id"
            referencedTableName="customers"
            referencedColumnNames="id"
            onDelete="CASCADE"
            onUpdate="RESTRICT"/>
    </changeSet>

    <changeSet id="4" author="test">
        <comment>Create order_items table with compound foreign keys</comment>
        <createTable tableName="order_items">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="unit_price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="5" author="test">
        <comment>Create products reference table</comment>
        <createTable tableName="products_fk">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="6" author="test">
        <comment>Add foreign key from order_items to orders</comment>
        <addForeignKeyConstraint
            constraintName="fk_order_items_order"
            baseTableName="order_items"
            baseColumnNames="order_id"
            referencedTableName="orders"
            referencedColumnNames="id"
            onDelete="CASCADE"
            onUpdate="RESTRICT"/>
    </changeSet>

    <changeSet id="7" author="test">
        <comment>Add foreign key from order_items to products</comment>
        <addForeignKeyConstraint
            constraintName="fk_order_items_product"
            baseTableName="order_items"
            baseColumnNames="product_id"
            referencedTableName="products_fk"
            referencedColumnNames="id"
            onDelete="RESTRICT"
            onUpdate="RESTRICT"/>
    </changeSet>

</databaseChangeLog>
