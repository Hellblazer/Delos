<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hellblazer.delos</groupId>
        <artifactId>delos.app</artifactId>
        <version>0.5.1-SNAPSHOT</version>
    </parent>
    <artifactId>choam</artifactId>
    <name>CHOAM</name>
    <description>Replicated State Machines and Consortium For Delos</description>
    <dependencies>
        <dependency>
            <groupId>com.hellblazer.delos</groupId>
            <artifactId>ethereal</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hellblazer.delos</groupId>
            <artifactId>memberships</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hellblazer.delos</groupId>
            <artifactId>tron</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2-mvstore</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>joou</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- Test only deps below this line -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Fast local testing: unit tests + quick tests only (fail-fast for development) -->
        <profile>
            <id>fast</id>
            <activation>
                <property>
                    <name>fast</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- Skip the long-running consensus tests -->
                            <excludes>
                                <exclude>**/DeterminismVerificationTest.java</exclude>
                            </excludes>
                            <!-- Parallelize unit tests for speed -->
                            <threadCountSuites>4</threadCountSuites>
                            <parallelSuite>true</parallelSuite>
                            <!-- Isolate each test to prevent state contamination -->
                            <reuseForks>false</reuseForks>
                            <forkCount>2</forkCount>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Determinism validation only: for production readiness verification -->
        <profile>
            <id>determinism-only</id>
            <activation>
                <property>
                    <name>determinism</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- Only run determinism test for Byzantine safety validation -->
                            <includes>
                                <include>**/DeterminismVerificationTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Full test suite: all tests with optimized epoch configs (CI) -->
        <profile>
            <id>full</id>
            <activation>
                <property>
                    <name>full</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- Run all tests, unit tests in parallel -->
                            <threadCountSuites>2</threadCountSuites>
                            <parallelSuite>true</parallelSuite>
                            <reuseForks>false</reuseForks>
                            <forkCount>2</forkCount>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
